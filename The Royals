<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The Royals | Sports & eSports Hub</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://googleapis.com">
    <link rel="preconnect" href="https://gstatic.com" crossorigin>
    <link href="https://googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">
    <!-- FontAwesome for Social Icons -->
    <link rel="stylesheet" href="https://cloudflare.com">
    
    <style>
        :root {
            --bg-black: #08080a;
            --card-bg: #121216;
            --neon-red: #ff2a2a;
            --neon-glow: rgba(255, 42, 42, 0.6);
            --text-main: #ffffff;
            --text-muted: #a0a0b0;
            --border-glow: 0 0 10px var(--neon-red);
            --text-glow: 0 0 8px var(--neon-red);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            scroll-behavior: smooth;
        }

        body {
            background-color: var(--bg-black);
            color: var(--text-main);
            font-family: 'Rajdhani', sans-serif;
            overflow-x: hidden;
            line-height: 1.6;
        }

        h1, h2, h3, .navbar-brand, .nav-links a {
            font-family: 'Orbitron', sans-serif;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        .section-padding {
            padding: 80px 0;
            border-bottom: 1px solid rgba(255, 42, 42, 0.1);
        }

        .neon-title {
            text-align: center;
            font-size: 2.5rem;
            margin-bottom: 50px;
            color: var(--text-main);
            text-shadow: var(--text-glow);
            position: relative;
        }

        .neon-title::after {
            content: '';
            display: block;
            width: 80px;
            height: 3px;
            background-color: var(--neon-red);
            margin: 15px auto 0;
            box-shadow: var(--border-glow);
        }

        /* Navbar Layout */
        .navbar {
            background-color: rgba(8, 8, 10, 0.95);
            border-bottom: 2px solid var(--neon-red);
            box-shadow: 0 2px 20px rgba(255, 42, 42, 0.2);
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 1000;
            backdrop-filter: blur(5px);
        }

        .nav-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            height: 80px;
        }

        .navbar-brand {
            font-size: 1.8rem;
            font-weight: 900;
            color: var(--text-main);
            text-decoration: none;
            text-shadow: var(--text-glow);
        }

        .navbar-brand span {
            color: var(--neon-red);
        }

        .nav-links {
            display: flex;
            list-style: none;
            gap: 30px;
        }

        .nav-links a {
            color: var(--text-main);
            text-decoration: none;
            font-size: 1rem;
            font-weight: 700;
            transition: all 0.3s ease;
            padding: 5px 10px;
        }

        .nav-links a:hover {
            color: var(--neon-red);
            text-shadow: var(--text-glow);
            border-bottom: 1px solid var(--neon-red);
        }

        /* Hero Banner Overlay */
        .hero {
            height: 100vh;
            background: linear-gradient(rgba(8, 8, 10, 0.5), rgba(8, 8, 10, 0.95)), 
                        url('https://unsplash.com') no-repeat center center/cover;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding-top: 80px;
            border-bottom: 3px solid var(--neon-red);
            position: relative;
        }

        .hero::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background-image: 
                linear-gradient(to right, rgba(255, 42, 42, 0.05) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255, 42, 42, 0.05) 1px, transparent 1px);
            background-size: 40px 40px;
            pointer-events: none;
        }

        .hero-content h1 {
            font-size: 4.5rem;
            font-weight: 900;
            margin-bottom: 20px;
            text-shadow: 0 0 20px var(--neon-red);
            animation: pulse 2s infinite alternate;
        }

        .hero-content p {
            font-size: 1.5rem;
            color: var(--text-muted);
            margin-bottom: 40px;
            max-width: 800px;
            margin-left: auto;
            margin-right: auto;
        }

        .cta-btn {
            display: inline-block;
            padding: 15px 40px;
            font-family: 'Orbitron', sans-serif;
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--text-main);
            background-color: transparent;
            border: 2px solid var(--neon-red);
            text-decoration: none;
            text-transform: uppercase;
            box-shadow: inset 0 0 10px rgba(255, 42, 42, 0.2), var(--border-glow);
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .cta-btn:hover {
            background-color: var(--neon-red);
            box-shadow: 0 0 25px var(--neon-red);
        }

        /* Player Profile Section */
        .profile-showcase {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
        }

        @media (max-width: 968px) {
            .profile-showcase {
                grid-template-columns: 1fr;
            }
        }

        .profile-card {
            background-color: var(--card-bg);
            border: 1px solid rgba(255, 42, 42, 0.2);
            padding: 30px;
            border-radius: 4px;
            position: relative;
            display: flex;
            flex-direction: column;
            transition: all 0.3s ease;
        }

        .profile-card:hover {
            border-color: var(--neon-red);
            box-shadow: 0 0 15px rgba(255, 42, 42, 0.2);
        }

        .profile-header {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 25px;
        }

        .profile-img-placeholder {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background-color: #1a1a24;
            border: 2px solid var(--neon-red);
            box-shadow: var(--border-glow);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            color: var(--neon-red);
        }

        .profile-title h3 {
            font-size: 1.6rem;
        }

        .profile-subtitle {
            color: var(--neon-red);
            font-weight: 700;
            font-size: 0.9rem;
            text-transform: uppercase;
        }

        .story-tabs {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
        }

        .tab-btn {
            flex: 1;
            padding: 10px;
            background: #181822;
            border: 1px solid rgba(255, 42, 42, 0.3);
            color: var(--text-muted);
            font-family: 'Orbitron', sans-serif;
            font-weight: 700;
            cursor: pointer;
            text-transform: uppercase;
            transition: all 0.3s ease;
        }

        .tab-btn.active, .tab-btn:hover {
            background-color: var(--neon-red);
            color: var(--text-main);
            border-color: var(--neon-red);
        }

        .story-content {
            display: none;
            font-size: 1.05rem;
            color: #d1d1d6;
            min-height: 140px;
        }

        .story-content.active {
            display: block;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            margin-top: auto;
            padding-top: 20px;
            border-top: 1px solid rgba(255, 42, 42, 0.1);
        }

        .stat-box {
            text-align: center;
            background: #16161e;
            padding: 10px;
        }

        .stat-value {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--neon-red);
        }

        .stat-label {
            font-size: 0.8rem;
            color: var(--text-muted);
            text-transform: uppercase;
        }

        /* Video System */
        .video-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 30px;
        }

        .video-card {
            background-color: var(--card-bg);
            border: 1px solid rgba(255, 42, 42, 0.1);
            border-radius: 4px;
            overflow: hidden;
        }

        .video-container {
            position: relative;
            padding-bottom: 56.25%;
            height: 0;
            background: #000;
        }

        .video-container iframe {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            border: 0;
        }

        .video-info {
            padding: 20px;
            border-top: 2px solid var(--neon-red);
        }

        /* Social Feeds */
        .social-feed-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 20px;
        }

